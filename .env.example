# OrderMind Environment Configuration Example
# Copy to .env for local configuration. Never commit .env.
# Run commands from the repository root; the SQLite path is relative to it.

# App Configuration
APP_ENV=development
APP_DEBUG=false
PORT=8001
HOST=127.0.0.1

# Database
# Default: SQLite in local development
DATABASE_URL=sqlite:///./ordermind.db

# AI Provider Configuration
# Implemented providers: mock (offline) and gemini. Others are planned.
AI_PROVIDER=mock
AI_MODEL=mock-model

# Set GEMINI_API_KEY only when AI_PROVIDER=gemini.
# The other credentials are placeholders for planned providers.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional input limits (current defaults)
MAX_RAW_ORDER_TEXT_SIZE=50000
MAX_ORDER_LINES=500
MAX_IMPORT_UPLOAD_SIZE_BYTES=10000000
