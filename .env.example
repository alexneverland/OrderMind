# OrderMind Environment Configuration Example
# Copy this file to .env and configure for your environment.
# NEVER commit .env to version control!

# App Configuration
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
# Default: SQLite in local development
DATABASE_URL=sqlite:///./ordermind.db
# For PostgreSQL: postgresql+psycopg://user:password@localhost:5432/ordermind

# AI Provider Configuration
# Supported providers: mock, gemini, openai, anthropic, vertex
AI_PROVIDER=mock
AI_MODEL=mock-model

# API Keys & Cloud Configuration (fill only in local .env, NEVER commit to git)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
